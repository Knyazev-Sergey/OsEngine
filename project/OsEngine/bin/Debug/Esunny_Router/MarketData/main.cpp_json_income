DWORD WINAPI serverReceive(LPVOID lpParam)
{
    SOCKET client = *(SOCKET*)lpParam;

    MessagesIn.clear();
    MessagesOut.clear();

    while (true)
    {
        try
        {
            string incoming;

            if (!RecvFrame(client, incoming))
            {
                cout << "recv function failed with error " << WSAGetLastError() << endl;
                return -1;
            }

            if (incoming.empty())
            {
                SendFrame(client, JsonError("empty_request", "Request payload is empty"));
                continue;
            }

            string cmd;

            if (!ExtractJsonStringField(incoming, "cmd", cmd))
            {
                SendFrame(client, JsonError("invalid_json", "Missing string field 'cmd'"));
                continue;
            }

            if (cmd == "poll")
            {
                lock_guard<mutex> inLock(mutex_array_out);

                if (!MessagesOut.empty())
                {
                    string out = MessagesOut.front();
                    MessagesOut.pop_front();
                    SendFrame(client, out);
                }
                else
                {
                    SendFrame(client, JsonOk("poll", "no_messages"));
                }
                continue;
            }

            /*if (cmd == "disconnect")
            {
                std::lock_guard<std::mutex> inLock(mutex_array_in);
                MessagesIn.push_back("D");
                SendFrame(client, JsonOk("disconnect", "accepted"));
                cout << "Client Disconnected." << endl;
