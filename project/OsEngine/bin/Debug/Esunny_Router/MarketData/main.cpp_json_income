static string EscapeJson(const string& s)
{
    string out;
    out.reserve(s.size() + 8);
    for (size_t i = 0; i < s.size(); ++i)
    {
        char c = s[i];
        if (c == '\\') out += "\\\\";
        else if (c == '"') out += "\\\"";
        else if (c == '\n') out += "\\n";
        else if (c == '\r') out += "\\r";
        else if (c == '\t') out += "\\t";
        else out += c;
    }
    return out;
}

static string JsonOk(const string& type, const string& message)
{
    return "{\"ok\":true,\"type\":\"" + EscapeJson(type) + "\",\"message\":\"" + EscapeJson(message) + "\"}";
}

static string JsonError(const string& code, const string& message)
{
    return "{\"ok\":false,\"error\":\"" + EscapeJson(code) + "\",\"message\":\"" + EscapeJson(message) + "\"}";
}

static bool RecvAll(SOCKET s, char* data, size_t n)
{
    size_t got = 0;
    while (got < n)
    {
        int ret = recv(s, data + got, (int)(n - got), 0);
        if (ret <= 0)
        {
            return false;
        }
        got += (size_t)ret;
    }
    return true;
}

static bool SendAll(SOCKET s, const char* data, size_t n)
{
    size_t sent = 0;
    while (sent < n)
    {
        int ret = send(s, data + sent, (int)(n - sent), 0);
        if (ret <= 0)
        {
            return false;
        }
        sent += (size_t)ret;
    }
    return true;
}

static bool RecvFrame(SOCKET s, string& out)
{
    uint32_t lenNet = 0;
    if (!RecvAll(s, reinterpret_cast<char*>(&lenNet), sizeof(lenNet)))
    {
        return false;
    }

    const uint32_t len = ntohl(lenNet);
    const uint32_t maxLen = 10U * 1024U * 1024U;
    if (len > maxLen)
    {
        return false;
    }

    out.clear();
    out.resize(len);
    if (len > 0 && !RecvAll(s, &out[0], len))
    {
        return false;
    }

    return true;
}

static bool SendFrame(SOCKET s, const string& msg)
{
    const uint32_t len = (uint32_t)msg.size();
    const uint32_t lenNet = htonl(len);

    if (!SendAll(s, reinterpret_cast<const char*>(&lenNet), sizeof(lenNet)))
    {
        return false;
    }
    if (len > 0 && !SendAll(s, msg.data(), len))
    {
        return false;
    }
    return true;
}

static bool ExtractJsonStringField(const string& json, const string& key, string& value)
{
    const string token = "\"" + key + "\"";
    const size_t keyPos = json.find(token);
    if (keyPos == string::npos)
    {
        return false;
    }

    const size_t colonPos = json.find(':', keyPos + token.size());
    if (colonPos == string::npos)
    {
        return false;
    }

    size_t q1 = json.find('"', colonPos + 1);
    if (q1 == string::npos)
    {
        return false;
    }

    size_t q2 = q1 + 1;
    while (q2 < json.size())
    {
        if (json[q2] == '"' && json[q2 - 1] != '\\')
        {
            break;
        }
        q2++;
    }

    if (q2 >= json.size())
    {
        return false;
    }

    value = json.substr(q1 + 1, q2 - q1 - 1);
    return true;
}

