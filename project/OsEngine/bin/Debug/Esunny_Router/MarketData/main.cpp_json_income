string DoubleToString(double val)
{
    string s = to_string(val);
    s.erase(s.find_last_not_of('0') + 1);
    s.erase(s.find_last_not_of('.') + 1);
    return s;
}

void GetSecuritiesList(apiClient* api)
{
    api->CommodityQry();

    if (api->ContractQry())
    {
        cout << "Api: ContractQry error" << endl;
    }

    while (true)
    {
        if (api->isLast1_cont && api->isLast1_comm)
        {     
            string msg = "";

            for (set<string>::iterator it = api->set_contract.begin(); it != api->set_contract.end(); it++)
            {     
                for (map<string, const DstarQuoteApiCommodityData >::iterator comm = api->map_commodity.begin(); comm != api->map_commodity.end(); comm++)
                {
                    string nameFull = *it;
                    string name = "";
                    size_t pos = 0;

                    for (int i = 0; i < 3; ++i)
                    {
                        pos = nameFull.find('|', pos);
                        ++pos;
                    }

                    name = nameFull.substr(0, pos - 1);

                    if (comm->first == name) 
                    {
                        msg += "{\"symbol\":\"" + *it + "\"," +
                            "\"exchange\":\"" + comm->second.ExchangeNo + "\"," +
                            "\"contractType\":\"" + comm->second.CommodityType + "\"," +
                            "\"contractSize\":" + DoubleToString(comm->second.ContractSize) + "," +
                            "\"contractTickSize\":" + DoubleToString(comm->second.ContractTickSize) + "}";
                    }
                }

                if (next(it) != api->set_contract.end())  
                {
                    msg += ",";
                }
            }

            string str = "{\"type\":\"security\",\"symbols\":[" + msg + "]}";

            //{"type":"security","symbols":[{"symbol":"AFLT", "contractSize": 200, "contractTickSize":0,01}]}
           
            cout << str << endl;

